<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Piezas comunes a las suites que levantan la API: la fabrica de la
    aplicacion, el cliente autenticado, el sustituto del correo y el firmador
    de eventos de Stripe. No contiene pruebas.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>Sems.Api.TestSupport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
    <!-- SQLite y no el proveedor InMemory: este si aplica los indices unicos -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sems.Api/Sems.Api.csproj" />
  </ItemGroup>

</Project>
