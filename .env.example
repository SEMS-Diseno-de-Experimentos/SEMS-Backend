# =============================================================================
#  SEMS - Backend (ASP.NET Core)
#  Plantilla de variables de entorno.
#
#  Copiar a .env y rellenar. .env esta en .gitignore y NO debe subirse nunca:
#  contiene la clave secreta de Stripe, la contrasena del correo y la de la base
#  de datos. Si alguna se sube por error, no basta con borrar el archivo del
#  repositorio: hay que rotar la credencial en el proveedor.
# =============================================================================

# ------------------------------------------------------------- base de datos
# Un solo Postgres para todo el monolito. Cada modulo aisla sus tablas por
# prefijo (dm_, em_, an_, al_, pm_, sb_, iam_).
DATABASE_URL=Host=localhost;Port=5432;Database=sems;Username=postgres;Password=cambiar

# -------------------------------------------------------------------- servidor
PORT=8080

# ------------------------------------------------------------------------ CORS
# Los tres origenes: las dos aplicaciones web desplegadas y el entorno local.
# Si falta uno, esa aplicacion falla con error de CORS y parece que el backend
# esta caido.
ALLOWED_ORIGINS=https://sems-web-application.vercel.app,https://sems-diseno-web.vercel.app,http://localhost:5173

# --------------------------------------------------------------------- seguridad
# Minimo 32 caracteres: HS256 lo exige. Generar uno aleatorio, no escribirlo a mano.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
JWT_REFRESH_EXPIRATION_DAYS=30
REQUIRE_VERIFICATION=false

# URL publica del frontend. Se usa para armar los enlaces de verificacion de
# cuenta y de recuperacion de contrasena que van dentro de los correos.
FRONTEND_URL=https://sems-diseno-web.vercel.app

# ------------------------------------------------------------------------ correo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Contrasena de aplicacion de Gmail, no la del correo personal.
MAIL_PASSWORD=
MAIL_FROM=
# Poner en false para no enviar nada mientras se desarrolla.
MAIL_ENABLED=true

# ------------------------------------------------------------------------- pagos
# sk_test_... mientras se desarrolla. La clave sk_live_ solo va en el hosting,
# nunca en un archivo del repositorio ni en una variable con prefijo VITE_.
STRIPE_SECRET_KEY=
# whsec_... lo entrega Stripe al crear el endpoint del webhook.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pen

# Identificadores de precio de cada plan. Si se dejan vacios, el cargador crea
# los planes igual, pero sin enlace a Stripe (no se podra cobrar).
STRIPE_PRICE_FREE=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
