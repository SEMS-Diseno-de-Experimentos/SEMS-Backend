# ------------------------------------------------------------------ ejecucion
PORT=8080

# ----------------------------------------------------------------- base datos
# Un solo Postgres para todos los modulos (Neon, Supabase o el que prefieras).
DATABASE_URL=jdbc:postgresql://host:5432/sems?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------------ seguridad
# Minimo 32 caracteres: HS256 lo exige y arrancar sin cambiarlo es inseguro.
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRATION_MINUTES=120
JWT_REFRESH_EXPIRATION_DAYS=30
AUTH_REQUIRED=true
# Pon true para exigir verificacion de correo antes del primer inicio de sesion
REQUIRE_VERIFICATION=false

# ----------------------------------------------------------------------- CORS
# Las tres aplicaciones que consumen esta API. Si falta una, esa aplicacion
# falla con error de CORS y parece que el backend esta caido.
ALLOWED_ORIGINS=https://sems-web-application.vercel.app,https://sems-diseno-web.vercel.app,http://localhost:5173

# URL publica del frontend, usada en los enlaces de verificacion y recuperacion
FRONTEND_URL=https://sems-web-application.vercel.app

# -------------------------------------------------------------- Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --------------------------------------------------------------------- correo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_ENABLED=true

# ---------------------------------------------------------------------- pagos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pen
STRIPE_PRICE_FREE=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
